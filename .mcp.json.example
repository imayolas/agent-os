{
  "//": "Copy this file to .mcp.json and fill in the servers you need. Reference all secrets via ${ENV_VAR}, never hardcoded values. .mcp.json is gitignored. MCP servers are optional — Agent OS works without any. Delete the examples below that you don't use.",
  "mcpServers": {
    "perplexity": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "notion": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "NOTION_TOKEN": "${NOTION_API_KEY}"
      }
    },
    "example-http-server": {
      "type": "http",
      "url": "https://mcp.example.com/http",
      "headers": {
        "Authorization": "Bearer ${EXAMPLE_API_KEY}"
      }
    }
  }
}
